{
	"name": "manual-order",
	"version": "1.0.0",
	"description": "Drag files and folders into any order in the Obsidian file explorer.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian-plugin"
	],
	"author": "Ian Wright",
	"repository": {
		"type": "git",
		"url": "https://github.com/pastureofmuppets/manual-order.git"
	},
	"license": "MIT",
	"dependencies": {
		"monkey-around": "^3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"obsidian": "1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
	}
}
